{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tacho-command",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tachocommand-prod",
      "database_id": "3c49c326-bf91-441f-a426-75b2e20c0a8f",
      "migrations_dir": "./drizzle"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "AUTH_EMAIL_FROM": "TachoCommand <support@tachocommand.com>",
    "AUTH_PUBLIC_ORIGIN": "https://tachocommand.com"
  },
  "secrets": {
    "required": ["EMAIL_ID_SECRET", "RESEND_API_KEY"]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": {
    "enabled": true
  }
}
