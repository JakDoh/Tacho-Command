{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tacho-command",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tachocommand-prod",
      "database_id": "6bbd3d4d-3e24-4ae2-b057-35a6dbbaa3b2",
      "migrations_dir": "./drizzle"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "AUTH_EMAIL_FROM": "onboarding@resend.dev",
    "AUTH_PUBLIC_ORIGIN": "https://tacho-command.jak-doh-work.workers.dev/"
  },
  "secrets": {
    "required": ["EMAIL_ID_SECRET", "RESEND_API_KEY"]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": {
    "enabled": true
  }
}
